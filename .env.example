# Copy to .env and fill in. Used by docker-compose.yml.

# Traefik routing: page is served at https://${SERVICE_NAME}.${DOMAIN}
TRAEFIK_NETWORK=traefik
SERVICE_NAME=register
DOMAIN=example.com

# AzerothCore network (docker network ls | grep ac-network)
AC_NETWORK_NAME=ix-azerothcore_ac-network

# Site
SITE_TITLE=Simple Register
# Shown on the contact page (leave empty to hide the contact page)
CONTACT_EMAIL=
TEMPLATE=icecrown
# Leave REALMLIST / REALM_NAME empty to take them from mod-realm-config's realm.conf
# (falls back to 127.0.0.1 / AzerothCore when there is no realm.conf)
REALMLIST=
REALM_NAME=
# Realm ID from acore_auth.realmlist (1 unless you run several realms)
REALM_ID=1
DEBUG_MODE=false

# Default language: english, persian, italian, chinese-simplified, chinese-traditional,
# swedish, french, german, spanish, korean, russian, portugues
LANGUAGE=english
# Show the language changer (true/false). false keeps everyone on LANGUAGE.
LANGUAGE_CHANGER=true

# Optional download link for a client patch, shown on the "How to connect" page
PATCH_URL=

# Turn pages off (true/false)
DISABLE_TOP_PLAYERS=false
DISABLE_ONLINE_PLAYERS=false
DISABLE_CHANGEPASSWORD=false

# Allow several accounts to share one email address (true/false)
MULTIPLE_EMAIL_USE=false

# Captcha: 0 = built-in image captcha, 1 = hCaptcha, 2 = reCAPTCHA v2,
# 3 = Cloudflare Turnstile, 4 = off. Types 1-3 need a site key and secret.
CAPTCHA_TYPE=0
CAPTCHA_KEY=
CAPTCHA_SECRET=

# Database user from docker/create-db-user.sql
DB_USER=wow_register
DB_PASS=CHANGE_ME
# AzerothCore MySQL port inside the Docker network
DB_PORT=3306

# Optional: SMTP for "forgot password"
SMTP_HOST=
SMTP_PORT=587
# tls (usually port 587) or ssl (usually port 465)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: host folder that mod-realm-config writes realm.conf to
# (the host side of RealmConfig.OutputDirectory). Served at https://SERVICE_NAME.DOMAIN/realm/
REALM_CONFIG_DIR=
# mod_realm_config.realm_key (the module writes <realm_key>.realm.conf).
# Leave empty to use the newest *.realm.conf in the folder.
REALM_KEY=
