# Copy to .env and fill in. Used by docker-compose.yml.

# Traefik routing: page is served at https://${SERVICE_NAME}.${DOMAIN}
TRAEFIK_NETWORK=traefik
SERVICE_NAME=register
DOMAIN=example.com

# AzerothCore network (docker network ls | grep ac-network)
AC_NETWORK_NAME=ix-azerothcore_ac-network

# Site
SITE_TITLE=Simple Register
# Shown on the contact page (leave empty to hide the contact page)
CONTACT_EMAIL=
# Leave REALMLIST / REALM_NAME empty to take them from mod-realm-config's realm.conf
# (falls back to 127.0.0.1 / AzerothCore when there is no realm.conf)
REALMLIST=
REALM_NAME=
# Realm ID from acore_auth.realmlist (1 unless you run several realms)
REALM_ID=1
DEBUG_MODE=false

# Optional download link for a client patch, shown on the "How to connect" page
PATCH_URL=

# Turn pages off (true/false)
DISABLE_TOP_PLAYERS=false
DISABLE_ONLINE_PLAYERS=false
DISABLE_CHANGEPASSWORD=false
# Close sign-ups: hides Register and refuses new accounts (create them from the worldserver console)
DISABLE_REGISTRATION=false
# Usernames players can't register (comma-separated prefixes). mod-playerbots deletes every account
# starting with AiPlayerbot.RandomBotAccountPrefix on a bot reset, so keep that prefix here. Empty refuses none.
RESERVED_USERNAME_PREFIXES=RNDBOT

# Rare map (rares.php): mod-rare-tracker's endpoint on the AzerothCore network. Empty hides the page.
# The worldserver serves it from memory on RareTracker.Http.Port; no port has to be published.
RARE_TRACKER_URL=
# Where the map images from mod-rare-tracker's tools/build_worldmaps.py are served.
# Default realm/worldmap/, i.e. a "worldmap" folder inside REALM_CONFIG_DIR.
WORLDMAP_URL=

# Patch notes page (changelog.php), built from merged pull requests on GitHub.
# The GitHub user or organization whose repos to read; empty hides the page and its menu link.
CHANGELOG_ORG=
# Which of its repos count (regex on the repo name). Default ^(wow-|mod-).
CHANGELOG_REPOS=
# Recommended: AzerothCore's modules/ folder on the host, e.g. /home/you/azerothcore-wotlk/modules.
# It's mounted read-only so the patch notes only show server-module changes the realm runs.
# Empty: show everything as soon as it's merged.
AC_MODULES_DIR=
# Advanced: read the module versions from somewhere else instead: a modules/ folder inside the
# container, a modules.tsv file (folder, url, branch, commit), or owner/repo:path on GitHub.
CHANGELOG_MANIFEST=
# Repos named like modules that are never gated (comma-separated). Default wow-mod-azerothcore-portal.
CHANGELOG_UNGATED=
# Time zone used to group notes by day, e.g. America/New_York. Default UTC.
CHANGELOG_TIMEZONE=
# How long to cache GitHub's answers, in seconds. Default 600.
CHANGELOG_CACHE_SECONDS=
# With the module versions known (AC_MODULES_DIR or CHANGELOG_MANIFEST), server-module changes stay
# off the page until the world server goes down for the restart that brings them, and the page
# refreshes right then, so players waiting to log back in can read what's coming. The portal tells a
# restart by the realm's start time in acore_auth.uptime (the uptime line of
# docker/create-db-user.sql.example) and by whether the world server answers at this address, so
# pull the modules right before you build: any restart counts, even one without a new build.
# Default ac-worldserver:8085; empty (or off) never probes.
WORLDSERVER_ADDRESS=ac-worldserver:8085
# GitHub token, recommended. Without one GitHub allows 60 requests an hour for your whole network.
# That's enough once the cache is warm, but the first build needs one request per module and README
# (about 100 for 70 modules), so it then takes a few hours to fill in. A fine-grained token with
# "Public repositories (read-only)" access is all it needs.
GITHUB_TOKEN=

# Launcher API (api/launcher/): game-account login for Portalkeeper, plus the private tracker and
# web seed that hand out the WoW client. Off by default. See "Launcher login and client download".
LAUNCHER_ENABLED=false
# With the launcher on, "How to connect" is just: register, get the launcher, INSTALL WOW. Where the
# launcher download link goes (default: the fork's latest GitHub release).
LAUNCHER_DOWNLOAD_URL=
# Launchers ask api/launcher/version.php for the newest release of this GitHub repo (default
# buildthehomelab/wow-Portalkeeper).
LAUNCHER_RELEASE_REPO=
# Optional: lets the launcher's release workflow announce a new release to the portal, so launchers
# get it within a minute. Use a long random value (openssl rand -hex 32) and set the same value as
# the launcher repo's Actions secret PORTAL_RELEASE_SECRET. Empty = announcements are off.
LAUNCHER_RELEASE_SECRET=
# How often the portal asks GitHub itself (default: 3600 s with a secret above, 120 s without)
LAUNCHER_VERSION_CACHE_SECONDS=
# Database for launcher logins and tracker peers (created by docker/create-db-user.sql)
LAUNCHER_DB_NAME=acore_launcher
# Days a launcher login lasts without being used
LAUNCHER_TOKEN_DAYS=30
# Host folder holding the .torrent files (client.torrent, ...), mounted read-only
LAUNCHER_TORRENT_DIR=
# Host folder holding the files those torrents describe, served as the web seed, mounted read-only.
# It contains the torrent's top folder, e.g. <dir>/Evermore/Wow.exe
LAUNCHER_CLIENT_DIR=
# Optional: where the patch MPQs are inside the container and their public URL, for the patch
# torrents. Defaults: the realm folder (/var/www/html/realm) and <seed host or BASE_URL>/realm.
LAUNCHER_PATCH_DIR=
LAUNCHER_PATCH_URL=
# Optional: where the realm.conf files are inside the container (default /var/www/html/realm). A patch
# torrent is only made from a file whose SHA-256 a realm.conf there gives it.
LAUNCHER_REALM_CONF_DIR=
# How many web seed addresses each torrent lists (1-16, default 4). Torrent clients use one connection
# per address and fetch a couple of MB at a time over each, so more addresses = more parallel
# downloads from this server.
LAUNCHER_WEB_SEEDS=4
# Behind Cloudflare (proxy or cloudflared tunnel): set to CF-Connecting-IP so the tracker and the
# login throttle see players' real addresses instead of Cloudflare's or the tunnel's. Leave empty
# unless every outside request goes through that proxy, since clients could otherwise send the header.
LAUNCHER_CLIENT_IP_HEADER=
# Optional: this network's public IP or a host name for it (e.g. your realmlist). Players on the
# server's own network are then handed to outside players at that address, so a launcher at home can
# share with friends (its router has to forward the launcher's port, e.g. by UPnP). Empty = players
# on the server's network only share with each other.
LAUNCHER_PUBLIC_ADDRESS=
# Optional, instead of the line above when you can open a port: a host for the tracker and web seeds
# that reaches Traefik directly, e.g. seed.example.com.
# Use it when the main host is behind Cloudflare or another proxy: give it a DNS-only record pointing
# at this server so the tracker sees players' real addresses. Patch web seeds default to it as well.
# Only the tracker, web seed and /realm/ paths answer on it.
LAUNCHER_SEED_HOST=

# Combat logs (needs LAUNCHER_ENABLED=true): players who turn on "Share combat logs" in the launcher
# upload their dungeon and raid logs, and combatlogs.php shows each one cut into fights (deaths,
# enemy abilities, interrupts, dispels). Off by default. See "Combat logs" in the README.
COMBATLOG_ENABLED=false
# Opens combatlogs.php and api/combatlogs.php: a long random value (openssl rand -hex 32).
# Empty = the logs are collected but nobody can read them through the portal.
COMBATLOG_VIEW_KEY=
# Days a log is kept (0 = forever) and the largest upload accepted, in MB of gzip (a 4-hour raid is about 10)
COMBATLOG_KEEP_DAYS=60
COMBATLOG_MAX_MB=512
# Optional: a host folder for the logs instead of the portal-combatlogs volume. It has to be
# writable by the container's www-data user (uid 33).
COMBATLOG_HOST_DIR=
# Accounts whose characters are bots (SQL LIKE pattern), marked as such in the digest
COMBATLOG_BOT_ACCOUNTS=RNDBOT%

# Crash reports (needs LAUNCHER_ENABLED=true): when World of Warcraft crashes, the launcher offers to
# send the error report the game wrote (Errors/*.txt), with the player's Windows and computer names
# taken out. Read them through api/crashreports.php. Off by default. See "Crash reports" in the README.
CRASHREPORT_ENABLED=false
# Opens api/crashreports.php. Empty = COMBATLOG_VIEW_KEY opens it (and with neither, nobody can read them).
CRASHREPORT_VIEW_KEY=
# Days a report is kept (0 = forever), and the room all reports may take (new ones are refused past it)
CRASHREPORT_KEEP_DAYS=90
CRASHREPORT_MAX_MB=200
# Optional: a host folder for the reports instead of the portal-crashreports volume (writable by uid 33)
CRASHREPORT_HOST_DIR=

# The launcher's home screen (needs LAUNCHER_ENABLED=true; see "Live info and what's new" in the
# README): players online, uptime and a pending restart, world events that are on, rares up. The
# server and events need SOAP_USER (below); rares need RARE_TRACKER_URL.
# Seconds one answer is reused for every launcher (each new one costs the worldserver two console commands)
LIVE_CACHE_SECONDS=30
# Accounts whose characters are bots (SQL LIKE pattern), counted apart from players
LIVE_BOT_ACCOUNTS=RNDBOT%
# World events, as comma-separated game_event ids. With SELECT on acore_world.game_event only holidays
# are shown; LIVE_SHOW_EVENTS adds others (a custom event), LIVE_HIDE_EVENTS drops any.
LIVE_SHOW_EVENTS=
LIVE_HIDE_EVENTS=

# Coin shop (needs LAUNCHER_ENABLED=true and mod-boss-coins on the worldserver): the launcher's Shop
# window, where players spend the coins in their account wallet on mounts, companions and character
# services. Off by default. See "Coin shop" in the README.
SHOP_ENABLED=false
# The worldserver's SOAP interface and an account it accepts (GM level 3), for the shop and the
# launcher's live info. The default address is the worldserver container on ac-network.
SOAP_URL=http://ac-worldserver:7878/
SOAP_USER=
SOAP_PASSWORD=
# Seconds a player's shop listing is reused before the worldserver is asked again (0 = every time)
SHOP_CACHE_SECONDS=15
# Purchases an account can make in a minute, refused ones included (each costs the worldserver a
# database read on its main thread)
SHOP_BUYS_PER_MINUTE=6
# Pictures of the offers (see "Pictures of the offers" in the README): the folder inside the container
# and its public URL. The defaults are the realm folder's shop/ and BASE_URL/realm/shop.
SHOP_PREVIEW_DIR=
SHOP_PREVIEW_URL=

# Legacy (needs LAUNCHER_ENABLED=true, SOAP_USER above and mod-legacy on the worldserver): the
# launcher's Legacy page, where players spend the points their account's challenges earned on each
# character's perks. Off by default. See "Legacy" in the README.
LEGACY_ENABLED=false
# Seconds a player's Legacy listing is reused before the worldserver is asked again (0 = every time)
LEGACY_CACHE_SECONDS=10
# Builds an account can save in a minute, refused ones included
LEGACY_SAVES_PER_MINUTE=6

# Captcha: 0 = built-in image captcha, 1 = hCaptcha, 2 = reCAPTCHA v2,
# 3 = Cloudflare Turnstile, 4 = off. Types 1-3 need a site key and secret.
CAPTCHA_TYPE=0
CAPTCHA_KEY=
CAPTCHA_SECRET=

# Database user from docker/create-db-user.sql
DB_USER=wow_register
DB_PASS=CHANGE_ME
# AzerothCore MySQL port inside the Docker network
DB_PORT=3306

# Optional: host folder that mod-realm-config writes realm.conf to
# (the host side of RealmConfig.OutputDirectory). Served at https://SERVICE_NAME.DOMAIN/realm/
REALM_CONFIG_DIR=
# mod_realm_config.realm_key (the module writes <realm_key>.realm.conf).
# Leave empty to use the newest *.realm.conf in the folder.
REALM_KEY=
