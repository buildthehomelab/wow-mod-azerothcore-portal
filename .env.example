# Copy to .env and fill in. Used by docker-compose.yml.

# Traefik routing: page is served at https://${SERVICE_NAME}.${DOMAIN}
TRAEFIK_NETWORK=traefik
SERVICE_NAME=register
DOMAIN=example.com

# AzerothCore network (docker network ls | grep ac-network)
AC_NETWORK_NAME=ix-azerothcore_ac-network

# Site
SITE_TITLE=Simple Register
# Shown on the contact page (leave empty to hide the contact page)
CONTACT_EMAIL=
# Leave REALMLIST / REALM_NAME empty to take them from mod-realm-config's realm.conf
# (falls back to 127.0.0.1 / AzerothCore when there is no realm.conf)
REALMLIST=
REALM_NAME=
# Realm ID from acore_auth.realmlist (1 unless you run several realms)
REALM_ID=1
DEBUG_MODE=false

# Optional download link for a client patch, shown on the "How to connect" page
PATCH_URL=

# Turn pages off (true/false)
DISABLE_TOP_PLAYERS=false
DISABLE_ONLINE_PLAYERS=false
DISABLE_CHANGEPASSWORD=false
# Close sign-ups: hides Register and refuses new accounts (create them from the worldserver console)
DISABLE_REGISTRATION=false
# Usernames players can't register (comma-separated prefixes). mod-playerbots deletes every account
# starting with AiPlayerbot.RandomBotAccountPrefix on a bot reset, so keep that prefix here. Empty refuses none.
RESERVED_USERNAME_PREFIXES=RNDBOT

# Rare map (rares.php): mod-rare-tracker's endpoint on the AzerothCore network. Empty hides the page.
# The worldserver serves it from memory on RareTracker.Http.Port; no port has to be published.
RARE_TRACKER_URL=
# Where the map images from mod-rare-tracker's tools/build_worldmaps.py are served.
# Default realm/worldmap/, i.e. a "worldmap" folder inside REALM_CONFIG_DIR.
WORLDMAP_URL=

# Patch notes page (changelog.php), built from merged pull requests on GitHub.
# The GitHub user or organization whose repos to read; empty hides the page and its menu link.
CHANGELOG_ORG=
# Which of its repos count (regex on the repo name). Default ^(wow-|mod-).
CHANGELOG_REPOS=
# Recommended: AzerothCore's modules/ folder on the host, e.g. /home/you/azerothcore-wotlk/modules.
# It's mounted read-only so the patch notes only show server-module changes the realm runs.
# Empty: show everything as soon as it's merged.
AC_MODULES_DIR=
# Advanced: read the module versions from somewhere else instead: a modules/ folder inside the
# container, a modules.tsv file (folder, url, branch, commit), or owner/repo:path on GitHub.
CHANGELOG_MANIFEST=
# Repos named like modules that are never gated (comma-separated). Default wow-mod-azerothcore-portal.
CHANGELOG_UNGATED=
# Time zone used to group notes by day, e.g. America/New_York. Default UTC.
CHANGELOG_TIMEZONE=
# How long to cache GitHub's answers, in seconds. Default 600.
CHANGELOG_CACHE_SECONDS=
# Optional GitHub token. Without one GitHub allows 60 requests an hour, which is enough once the
# cache is warm. A fine-grained token with "Public repositories (read-only)" access is all it needs.
GITHUB_TOKEN=

# Launcher API (api/launcher/): game-account login for Portalkeeper, plus the private tracker and
# web seed that hand out the WoW client. Off by default. See "Launcher login and client download".
LAUNCHER_ENABLED=false
# Database for launcher logins and tracker peers (created by docker/create-db-user.sql)
LAUNCHER_DB_NAME=acore_launcher
# Days a launcher login lasts without being used
LAUNCHER_TOKEN_DAYS=30
# Host folder holding the .torrent files (client.torrent, ...), mounted read-only
LAUNCHER_TORRENT_DIR=
# Host folder holding the files those torrents describe, served as the web seed, mounted read-only.
# It contains the torrent's top folder, e.g. <dir>/Evermore/Wow.exe
LAUNCHER_CLIENT_DIR=
# Optional: where the patch MPQs are inside the container and their public URL, for the patch
# torrents. Defaults: the realm folder (/var/www/html/realm) and BASE_URL/realm.
LAUNCHER_PATCH_DIR=
LAUNCHER_PATCH_URL=

# Captcha: 0 = built-in image captcha, 1 = hCaptcha, 2 = reCAPTCHA v2,
# 3 = Cloudflare Turnstile, 4 = off. Types 1-3 need a site key and secret.
CAPTCHA_TYPE=0
CAPTCHA_KEY=
CAPTCHA_SECRET=

# Database user from docker/create-db-user.sql
DB_USER=wow_register
DB_PASS=CHANGE_ME
# AzerothCore MySQL port inside the Docker network
DB_PORT=3306

# Optional: host folder that mod-realm-config writes realm.conf to
# (the host side of RealmConfig.OutputDirectory). Served at https://SERVICE_NAME.DOMAIN/realm/
REALM_CONFIG_DIR=
# mod_realm_config.realm_key (the module writes <realm_key>.realm.conf).
# Leave empty to use the newest *.realm.conf in the folder.
REALM_KEY=
