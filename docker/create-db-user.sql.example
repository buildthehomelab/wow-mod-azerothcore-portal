-- MySQL user for the registration page (instead of root).
-- Copy to create-db-user.sql, set the password (same as DB_PASS in .env), then run:
--   docker exec -i ac-database mysql -uroot -p < docker/create-db-user.sql
CREATE USER IF NOT EXISTS 'wow_register'@'%' IDENTIFIED BY 'CHANGE_ME';
GRANT SELECT, INSERT, UPDATE ON acore_auth.account  TO 'wow_register'@'%';
GRANT SELECT                 ON acore_characters.*  TO 'wow_register'@'%';

-- Launcher database, whose tables the portal creates itself. Needed even with LAUNCHER_ENABLED=false:
-- Register and Change Password keep their throttle counters there and refuse without it. Also ban
-- checks for the launcher API. Safe to run again on an existing install.
CREATE DATABASE IF NOT EXISTS acore_launcher;
GRANT ALL                    ON acore_launcher.*          TO 'wow_register'@'%';
GRANT SELECT                 ON acore_auth.account_banned TO 'wow_register'@'%';

-- Combat logs (COMBATLOG_ENABLED=true), optional: lets the digest name bosses from the realm's own
-- creature data instead of guessing them from the log.
GRANT SELECT                 ON acore_world.creature_template   TO 'wow_register'@'%';
GRANT SELECT                 ON acore_world.instance_encounters TO 'wow_register'@'%';
-- Launcher home screen (api/launcher/live.php), optional: shows only holidays among the world events
-- that are on, instead of every active event (fishing pools, arena seasons and the like).
GRANT SELECT                 ON acore_world.game_event          TO 'wow_register'@'%';
-- Patch notes (CHANGELOG_ORG with AC_MODULES_DIR), recommended: lets the page see when the world
-- server last started, so server-module changes appear with the restart that brings them rather
-- than when the modules folder is pulled.
GRANT SELECT                 ON acore_auth.uptime               TO 'wow_register'@'%';
-- Character order (CHARACTER_ORDER_ENABLED=true): lets the launcher save the order of a player's
-- characters on the character select screen. Only that one column; the core never writes it.
GRANT UPDATE (`order`)       ON acore_characters.characters     TO 'wow_register'@'%';
FLUSH PRIVILEGES;
